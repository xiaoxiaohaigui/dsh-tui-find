{
  "name": "dsh-tui-find",
  "version": "0.1.0",
  "description": "Cross-session full-text search for dsh-TUI — /find over all local dsh session logs (zstd frame chains and plain JSONL), read-only.",
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "dsh-plugin.json",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "vitest run",
    "fixtures": "node scripts/make-fixtures.mjs"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-atomic-write": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-harness-tui/dsh-tui": "0.9.3",
    "@dsh-std/core": "^0.1.0-rc1",
    "@dsh-std/manifest": "^0.1.0-rc1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.2",
    "csstype": "^3.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
